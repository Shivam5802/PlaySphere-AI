# ─────────────────────────────────────────────────────────────
# PlaySphere AI — Environment Variables Template
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── Firebase Configuration (Client SDK) ──────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Google Maps API Key (Client & Server) ─────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── AI / LLM Configuration (Groq / OpenAI compatible) ─────────
LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key
LLM_MODEL=llama-3.1-8b-instant

# ── Admin Access ──────────────────────────────────────────────
# Comma-separated Firebase Auth email(s) that are granted Super Admin role.
ADMIN_EMAILS=superadmin@example.com
NEXT_PUBLIC_ADMIN_EMAILS=superadmin@example.com

# ── Admin Bypass / Seed Credentials ───────────────────────────
NEXT_PUBLIC_ADMIN_EMAIL=superadmin@example.com
NEXT_PUBLIC_ADMIN_PASSWORD=your_admin_password

